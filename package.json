{
  "name": "@guoguoguilai/paseo-file-actions",
  "version": "0.1.0",
  "description": "Paseo plugin: run your own programs and commands on a file from its tab's Open with… menu, such as opening a Markdown note in Obsidian.",
  "author": "guoguoguilai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoguoguilai/paseo-file-actions.git"
  },
  "homepage": "https://github.com/guoguoguilai/paseo-file-actions#readme",
  "bugs": {
    "url": "https://github.com/guoguoguilai/paseo-file-actions/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "open-with",
    "file",
    "obsidian",
    "editor"
  ],
  "files": [
    "assets/",
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "LICENSE",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.14.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
